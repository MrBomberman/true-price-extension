{
	"name": "true-cost-extension",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Compare the real unit price of everyday purchases. Vanilla JavaScript Chrome extension.",
	"scripts": {
		"test": "node --test tests/*.test.js",
		"preview": "python3 -m http.server 4173 --bind 127.0.0.1",
		"lint": "eslint . && npm run format:check",
		"lint:fix": "eslint . --fix && npm run format",
		"format": "prettier --write \"**/*.{js,html}\" package.json manifest.json .prettierrc.json README.md",
		"format:check": "prettier --check \"**/*.{js,html}\" package.json manifest.json .prettierrc.json README.md"
	},
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.15.0",
		"globals": "^17.14.0",
		"prettier": "^3.10.1"
	}
}
